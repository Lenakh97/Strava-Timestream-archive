{
  "name": "aws-stravachallenge",
  "version": "0.0.0-development",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lenakh97/Strava-Timestream-archive.git"
  },
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-iam": "3.726.1",
    "@aws-sdk/client-ses": "3.726.1",
    "@aws-sdk/client-ssm": "3.726.1",
    "@aws-sdk/client-timestream-query": "3.726.1",
    "@aws-sdk/client-timestream-write": "3.726.1",
    "@aws-sdk/util-dynamodb": "3.726.1",
    "@bifravst/eslint-config-typescript": "6.1.20",
    "@commitlint/config-conventional": "19.6.0",
    "@nordicsemiconductor/asset-tracker-cloud-code-style": "13.1.16",
    "@nordicsemiconductor/eslint-config-asset-tracker-cloud-typescript": "17.0.0",
    "@swc/cli": "0.6.0",
    "@swc/jest": "0.2.37",
    "@types/aws-lambda": "8.10.147",
    "@types/jest": "29.5.14",
    "@types/yazl": "3.3.1",
    "aws-cdk": "2.174.1",
    "aws-cdk-lib": "2.174.1",
    "cdk": "2.174.1",
    "glob": "11.0.1",
    "husky": "9.1.7",
    "commander": "12.1.0",
    "jest": "29.7.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "yazl": "3.3.1"
  },
  "jest": {
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "@swc/jest"
      ]
    },
    "testRegex": ".+\\.spec\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failTitle": false
        }
      ]
    ]
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.726.1",
    "@bifravst/prettier-config": "^1.1.4",
    "@nordicsemiconductor/from-env": "3.0.1",
    "@nordicsemiconductor/timestream-helpers": "6.0.2",
    "date-fns": "4.1.0"
  }
}
